    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.0",
    "mongodb-memory-server": "^10.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
